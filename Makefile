# Directories
SRC_DIR = src
BOOTLOADER_DIR = $(SRC_DIR)/bootloader
UTILS_DIR = $(SRC_DIR)/utils
DESCRIPTOR_TABLES_DIR = $(SRC_DIR)/descriptor_tables
DISPLAY_DIR = $(SRC_DIR)/display
DRIVER_DIR = $(SRC_DIR)/drivers
STORAGE_DIR = $(SRC_DIR)/storage
FILESYSTEM_DIR = $(SRC_DIR)/filesystem
EXECUTABLE_DIR = $(SRC_DIR)/executable
BUILD_DIR = build
INTERMEDIATE_DIR = $(BUILD_DIR)/inter
PROGRAM_BUILD_DIR = $(BUILD_DIR)/programs

# Tools
ASSEMBLER = nasm
C_COMPILER = gcc
HOST_C_COMPILER = gcc
LINKER = ld
OBJ_COPY = objcopy
IMAGE_MAKER = dd
EMULATOR = qemu-system-i386

# Disk Layout
DISK_SECTOR_SIZE = 512
DISK_SECTOR_COUNT = 2880
FILESYSTEM_FIRST_SECTOR = 128

# Flags
ASSEMBLER_FLAGS_BINARY = -f bin -I $(SRC_DIR)
ASSEMBLER_FLAGS_ELF = -f elf32
C_COMPILER_FLAGS = -m32 -mno-sse -mno-sse2 -mno-mmx -ffreestanding -g -nostdlib -fno-stack-protector -O0 -fno-omit-frame-pointer -Wall -Wextra -I $(SRC_DIR) -DFILESYSTEM_FIRST_SECTOR=$(FILESYSTEM_FIRST_SECTOR)
OBJ_COPY_FLAGS = -O binary
LINKER_FLAGS = -m elf_i386
EMULATOR_FLAGS = -m 512 -vga std
EMULATOR_DEBUG_FLAGS = -s -S #-monitor stdio # then type info registers

# Source Files
BOOT_SOURCE = $(BOOTLOADER_DIR)/bootloader.asm
GDT_SOURCE = $(DESCRIPTOR_TABLES_DIR)/gdt.asm
START_PROTECTED_SOURCE = $(BOOTLOADER_DIR)/start_protected.asm
KERNEL_MAIN_SOURCE = $(SRC_DIR)/kernel.c
IDT_SOURCE = $(DESCRIPTOR_TABLES_DIR)/idt.c
ISR_SOURCE = $(DESCRIPTOR_TABLES_DIR)/isr.asm
VGA_SOURCE = $(DISPLAY_DIR)/vga.c
KEYBOARD_DRIVER_SOURCE = $(DRIVER_DIR)/keyboard.c
ATA_DRIVER_SOURCE = $(DRIVER_DIR)/ata.c
BLOCK_DEVICE_SOURCE = $(STORAGE_DIR)/block_device.c
FILESYSTEM_STORAGE_SOURCE = $(STORAGE_DIR)/filesystem_storage.c
FILESYSTEM_SOURCE = $(FILESYSTEM_DIR)/filesystem.c
MEMORY_SOURCE = $(UTILS_DIR)/memory.c
EXECUTABLE_LOADER_SOURCE = $(EXECUTABLE_DIR)/executable_loader.c
EXECUTABLE_CALL_SOURCE = $(EXECUTABLE_DIR)/executable_call.asm
LINKER_SOURCE = linker.ld

# Include Files
TYPES_HEADER = $(UTILS_DIR)/types.h
IDT_HEADER = $(DESCRIPTOR_TABLES_DIR)/idt.h
PORTS_HEADER = $(UTILS_DIR)/ports.h
VGA_HEADER = $(DISPLAY_DIR)/vga.h
WELCOME_SCREEN_HEADER = $(DISPLAY_DIR)/welcome_screen.h
KEYBOARD_DRIVER_HEADER = $(DRIVER_DIR)/keyboard.h
ATA_DRIVER_HEADER = $(DRIVER_DIR)/ata.h
BLOCK_DEVICE_HEADER = $(STORAGE_DIR)/block_device.h
FILESYSTEM_STORAGE_HEADER = $(STORAGE_DIR)/filesystem_storage.h
FILESYSTEM_HEADER = $(FILESYSTEM_DIR)/filesystem.h
MEMORY_HEADER = $(UTILS_DIR)/memory.h
EXECUTABLE_LOADER_HEADER = $(EXECUTABLE_DIR)/executable_loader.h
PROGRAM_SERVICES_HEADER = $(EXECUTABLE_DIR)/program_services.h

# Intermediate Files
BOOT_BINARY =  $(INTERMEDIATE_DIR)/bootloader.bin
START_PROTECTED_OBJECT = $(INTERMEDIATE_DIR)/start_protected.o
KERNEL_MAIN_OBJECT = $(INTERMEDIATE_DIR)/kernel.o
IDT_OBJECT = $(INTERMEDIATE_DIR)/idt.o
ISR_OBJECT = $(INTERMEDIATE_DIR)/isr.o
VGA_OBJECT = $(INTERMEDIATE_DIR)/vga.o
KEYBOARD_DRIVER_OBJECT = $(INTERMEDIATE_DIR)/keyboard.o
ATA_DRIVER_OBJECT = $(INTERMEDIATE_DIR)/ata.o
BLOCK_DEVICE_OBJECT = $(INTERMEDIATE_DIR)/block_device.o
FILESYSTEM_STORAGE_OBJECT = $(INTERMEDIATE_DIR)/filesystem_storage.o
FILESYSTEM_OBJECT = $(INTERMEDIATE_DIR)/filesystem.o
MEMORY_OBJECT = $(INTERMEDIATE_DIR)/memory.o
EXECUTABLE_LOADER_OBJECT = $(INTERMEDIATE_DIR)/executable_loader.o
EXECUTABLE_CALL_OBJECT = $(INTERMEDIATE_DIR)/executable_call.o
SECOND_STAGE_LINKED = $(INTERMEDIATE_DIR)/second_stage.elf
SECOND_STAGE_BINARY = $(INTERMEDIATE_DIR)/second_stage.bin

# Final Target
TARGET = $(BUILD_DIR)/disk.img
FILESYSTEM_IMAGE_TOOL = $(BUILD_DIR)/filesystem_image
FILESYSTEM_IMAGE_TOOL_SOURCE = tools/filesystem_image.c
EXECUTABLE_PACKAGER = $(BUILD_DIR)/executable_packager
EXECUTABLE_PACKAGER_SOURCE = tools/executable_packager.c
EXECUTABLE_FORMAT_HEADER = $(SRC_DIR)/executable/executable_format.h

SHELL_SOURCE = programs/shell/shell.c
SHELL_LINKER_SOURCE = programs/shell/linker.ld
SHELL_OBJECT = $(PROGRAM_BUILD_DIR)/shell.o
SHELL_LINKED = $(PROGRAM_BUILD_DIR)/shell.elf
SHELL_BINARY = $(PROGRAM_BUILD_DIR)/shell.bin
SHELL_EXECUTABLE = $(PROGRAM_BUILD_DIR)/shell.evx
SHELL_LOAD_ADDRESS = 0x00200000
CHILD_LINKER_SOURCE = programs/child_linker.ld
CHILD_LOAD_ADDRESS = 0x00300000
ECHO_SOURCE = programs/echo/echo.c
ECHO_OBJECT = $(PROGRAM_BUILD_DIR)/echo.o
ECHO_LINKED = $(PROGRAM_BUILD_DIR)/echo.elf
ECHO_BINARY = $(PROGRAM_BUILD_DIR)/echo.bin
ECHO_EXECUTABLE = $(PROGRAM_BUILD_DIR)/echo.evx
CAT_SOURCE = programs/cat/cat.c
CAT_OBJECT = $(PROGRAM_BUILD_DIR)/cat.o
CAT_LINKED = $(PROGRAM_BUILD_DIR)/cat.elf
CAT_BINARY = $(PROGRAM_BUILD_DIR)/cat.bin
CAT_EXECUTABLE = $(PROGRAM_BUILD_DIR)/cat.evx
EXIT_SOURCE = programs/exit/exit.c
EXIT_OBJECT = $(PROGRAM_BUILD_DIR)/exit.o
EXIT_LINKED = $(PROGRAM_BUILD_DIR)/exit.elf
EXIT_BINARY = $(PROGRAM_BUILD_DIR)/exit.bin
EXIT_EXECUTABLE = $(PROGRAM_BUILD_DIR)/exit.evx
PROGRAM_STACK_SIZE = 0x00010000
PROGRAM_C_COMPILER_FLAGS = -m32 -mno-sse -mno-sse2 -mno-mmx -ffreestanding -ffunction-sections -nostdlib -fno-stack-protector -fno-pie -fno-pic -fno-asynchronous-unwind-tables -fno-unwind-tables -O0 -Wall -Wextra -I $(SRC_DIR)

# Phony Targets
.PHONY: prepare all filesystem-tool programs install-programs run _run clean _clean debug gdb

# Main Build Target
all: prepare $(TARGET)

filesystem-tool: prepare $(FILESYSTEM_IMAGE_TOOL)

programs: prepare $(SHELL_EXECUTABLE) $(ECHO_EXECUTABLE) $(CAT_EXECUTABLE) $(EXIT_EXECUTABLE)

install-programs: all filesystem-tool programs
	$(FILESYSTEM_IMAGE_TOOL) format $(TARGET) shell $(SHELL_EXECUTABLE) echo $(ECHO_EXECUTABLE) cat $(CAT_EXECUTABLE) exit $(EXIT_EXECUTABLE)

$(FILESYSTEM_IMAGE_TOOL): $(FILESYSTEM_IMAGE_TOOL_SOURCE) $(FILESYSTEM_SOURCE) $(FILESYSTEM_HEADER) $(FILESYSTEM_STORAGE_SOURCE) $(FILESYSTEM_STORAGE_HEADER) $(BLOCK_DEVICE_SOURCE) $(BLOCK_DEVICE_HEADER) $(MEMORY_SOURCE) $(MEMORY_HEADER)
	$(HOST_C_COMPILER) -Wall -Wextra -Werror -I $(SRC_DIR) -DFILESYSTEM_FIRST_SECTOR=$(FILESYSTEM_FIRST_SECTOR) $(FILESYSTEM_IMAGE_TOOL_SOURCE) $(FILESYSTEM_SOURCE) $(FILESYSTEM_STORAGE_SOURCE) $(BLOCK_DEVICE_SOURCE) $(MEMORY_SOURCE) -o $(FILESYSTEM_IMAGE_TOOL)

$(EXECUTABLE_PACKAGER): $(EXECUTABLE_PACKAGER_SOURCE) $(EXECUTABLE_FORMAT_HEADER) | $(BUILD_DIR)
	$(HOST_C_COMPILER) -Wall -Wextra -Werror -I $(SRC_DIR) $(EXECUTABLE_PACKAGER_SOURCE) -o $(EXECUTABLE_PACKAGER)

$(SHELL_OBJECT): $(SHELL_SOURCE) $(TYPES_HEADER) $(PROGRAM_SERVICES_HEADER) | $(PROGRAM_BUILD_DIR)
	$(C_COMPILER) $(PROGRAM_C_COMPILER_FLAGS) -c $(SHELL_SOURCE) -o $(SHELL_OBJECT)

$(SHELL_LINKED): $(SHELL_OBJECT) $(SHELL_LINKER_SOURCE)
	$(LINKER) $(LINKER_FLAGS) -T $(SHELL_LINKER_SOURCE) -o $(SHELL_LINKED) $(SHELL_OBJECT)

$(SHELL_BINARY): $(SHELL_LINKED)
	$(OBJ_COPY) $(OBJ_COPY_FLAGS) $(SHELL_LINKED) $(SHELL_BINARY)

$(SHELL_EXECUTABLE): $(SHELL_BINARY) $(EXECUTABLE_PACKAGER)
	$(EXECUTABLE_PACKAGER) $(SHELL_BINARY) $(SHELL_EXECUTABLE) $(SHELL_LOAD_ADDRESS) 0 $(PROGRAM_STACK_SIZE)

$(ECHO_OBJECT): $(ECHO_SOURCE) $(TYPES_HEADER) $(PROGRAM_SERVICES_HEADER) | $(PROGRAM_BUILD_DIR)
	$(C_COMPILER) $(PROGRAM_C_COMPILER_FLAGS) -c $(ECHO_SOURCE) -o $(ECHO_OBJECT)

$(ECHO_LINKED): $(ECHO_OBJECT) $(CHILD_LINKER_SOURCE)
	$(LINKER) $(LINKER_FLAGS) -T $(CHILD_LINKER_SOURCE) -o $(ECHO_LINKED) $(ECHO_OBJECT)

$(ECHO_BINARY): $(ECHO_LINKED)
	$(OBJ_COPY) $(OBJ_COPY_FLAGS) $(ECHO_LINKED) $(ECHO_BINARY)

$(ECHO_EXECUTABLE): $(ECHO_BINARY) $(EXECUTABLE_PACKAGER)
	$(EXECUTABLE_PACKAGER) $(ECHO_BINARY) $(ECHO_EXECUTABLE) $(CHILD_LOAD_ADDRESS) 0 $(PROGRAM_STACK_SIZE)

$(CAT_OBJECT): $(CAT_SOURCE) $(TYPES_HEADER) $(PROGRAM_SERVICES_HEADER) | $(PROGRAM_BUILD_DIR)
	$(C_COMPILER) $(PROGRAM_C_COMPILER_FLAGS) -c $(CAT_SOURCE) -o $(CAT_OBJECT)

$(CAT_LINKED): $(CAT_OBJECT) $(CHILD_LINKER_SOURCE)
	$(LINKER) $(LINKER_FLAGS) -T $(CHILD_LINKER_SOURCE) -o $(CAT_LINKED) $(CAT_OBJECT)

$(CAT_BINARY): $(CAT_LINKED)
	$(OBJ_COPY) $(OBJ_COPY_FLAGS) $(CAT_LINKED) $(CAT_BINARY)

$(CAT_EXECUTABLE): $(CAT_BINARY) $(EXECUTABLE_PACKAGER)
	$(EXECUTABLE_PACKAGER) $(CAT_BINARY) $(CAT_EXECUTABLE) $(CHILD_LOAD_ADDRESS) 0 $(PROGRAM_STACK_SIZE)

$(EXIT_OBJECT): $(EXIT_SOURCE) $(TYPES_HEADER) $(PROGRAM_SERVICES_HEADER) | $(PROGRAM_BUILD_DIR)
	$(C_COMPILER) $(PROGRAM_C_COMPILER_FLAGS) -c $(EXIT_SOURCE) -o $(EXIT_OBJECT)

$(EXIT_LINKED): $(EXIT_OBJECT) $(CHILD_LINKER_SOURCE)
	$(LINKER) $(LINKER_FLAGS) -T $(CHILD_LINKER_SOURCE) -o $(EXIT_LINKED) $(EXIT_OBJECT)

$(EXIT_BINARY): $(EXIT_LINKED)
	$(OBJ_COPY) $(OBJ_COPY_FLAGS) $(EXIT_LINKED) $(EXIT_BINARY)

$(EXIT_EXECUTABLE): $(EXIT_BINARY) $(EXECUTABLE_PACKAGER)
	$(EXECUTABLE_PACKAGER) $(EXIT_BINARY) $(EXIT_EXECUTABLE) $(CHILD_LOAD_ADDRESS) 0 $(PROGRAM_STACK_SIZE)

# Prepare Directories
prepare: $(BUILD_DIR) $(INTERMEDIATE_DIR) $(PROGRAM_BUILD_DIR)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(INTERMEDIATE_DIR): $(BUILD_DIR)
	mkdir -p $(INTERMEDIATE_DIR)

$(PROGRAM_BUILD_DIR): $(BUILD_DIR)
	mkdir -p $(PROGRAM_BUILD_DIR)

# Build Disk Image
$(TARGET): $(BOOT_BINARY) $(SECOND_STAGE_BINARY)
	@stage2_size=$$(stat -c%s $(SECOND_STAGE_BINARY)); \
	sectors=$$(( ($$stage2_size + $(DISK_SECTOR_SIZE) - 1) / $(DISK_SECTOR_SIZE) )); \
	if [ $$sectors -ge $(FILESYSTEM_FIRST_SECTOR) ]; then \
		echo "Error: second stage uses $$sectors sectors and overlaps filesystem sector $(FILESYSTEM_FIRST_SECTOR)"; \
		exit 1; \
	fi
	@if [ ! -f $(TARGET) ]; then \
		$(IMAGE_MAKER) if=/dev/zero of=$(TARGET) bs=$(DISK_SECTOR_SIZE) count=$(DISK_SECTOR_COUNT); \
	fi
	$(IMAGE_MAKER) if=$(BOOT_BINARY) of=$(TARGET) conv=notrunc
	$(IMAGE_MAKER) if=/dev/zero of=$(TARGET) bs=$(DISK_SECTOR_SIZE) seek=1 count=$$(( $(FILESYSTEM_FIRST_SECTOR) - 1 )) conv=notrunc
	$(IMAGE_MAKER) if=$(SECOND_STAGE_BINARY) of=$(TARGET) bs=512 seek=1 conv=notrunc
	@stage2_size=$$(stat -c%s $(SECOND_STAGE_BINARY)); \
	sectors=$$(( ($$stage2_size + $(DISK_SECTOR_SIZE) - 1) / $(DISK_SECTOR_SIZE) )); \
	echo "Second stage is $$sectors sectors"; \
	printf "$$(printf '\\x%02x' $$sectors)" | dd of=$(TARGET) bs=1 seek=509 conv=notrunc

# Build Bootloader
$(BOOT_BINARY): $(BOOT_SOURCE) $(GDT_SOURCE)
	$(ASSEMBLER) $(ASSEMBLER_FLAGS_BINARY) $(BOOT_SOURCE) -o $(BOOT_BINARY)

# Build Protected Mode Startup
$(START_PROTECTED_OBJECT): $(START_PROTECTED_SOURCE) $(IDT_OBJECT)
	$(ASSEMBLER) $(ASSEMBLER_FLAGS_ELF) $(START_PROTECTED_SOURCE) -o $(START_PROTECTED_OBJECT)

# Build IDT and ISR
$(IDT_OBJECT): $(IDT_SOURCE) $(ISR_OBJECT) $(TYPES_HEADER) $(IDT_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(IDT_SOURCE) -o $(IDT_OBJECT)

$(ISR_OBJECT): $(ISR_SOURCE) $(KEYBOARD_DRIVER_OBJECT)
	$(ASSEMBLER) $(ASSEMBLER_FLAGS_ELF) $(ISR_SOURCE) -o $(ISR_OBJECT)

$(VGA_OBJECT): $(VGA_SOURCE) $(VGA_HEADER) $(TYPES_HEADER) $(PORTS_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(VGA_SOURCE) -o $(VGA_OBJECT)

$(KEYBOARD_DRIVER_OBJECT): $(KEYBOARD_DRIVER_SOURCE) $(KEYBOARD_DRIVER_HEADER) $(TYPES_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(KEYBOARD_DRIVER_SOURCE) -o $(KEYBOARD_DRIVER_OBJECT)

$(ATA_DRIVER_OBJECT): $(ATA_DRIVER_SOURCE) $(ATA_DRIVER_HEADER) $(TYPES_HEADER) $(PORTS_HEADER) $(BLOCK_DEVICE_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(ATA_DRIVER_SOURCE) -o $(ATA_DRIVER_OBJECT)

$(BLOCK_DEVICE_OBJECT): $(BLOCK_DEVICE_SOURCE) $(BLOCK_DEVICE_HEADER) $(TYPES_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(BLOCK_DEVICE_SOURCE) -o $(BLOCK_DEVICE_OBJECT)

$(FILESYSTEM_STORAGE_OBJECT): $(FILESYSTEM_STORAGE_SOURCE) $(FILESYSTEM_STORAGE_HEADER) $(BLOCK_DEVICE_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(FILESYSTEM_STORAGE_SOURCE) -o $(FILESYSTEM_STORAGE_OBJECT)

$(MEMORY_OBJECT): $(MEMORY_SOURCE) $(MEMORY_HEADER) $(TYPES_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(MEMORY_SOURCE) -o $(MEMORY_OBJECT)

$(FILESYSTEM_OBJECT): $(FILESYSTEM_SOURCE) $(FILESYSTEM_HEADER) $(FILESYSTEM_STORAGE_HEADER) $(MEMORY_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(FILESYSTEM_SOURCE) -o $(FILESYSTEM_OBJECT)

$(EXECUTABLE_LOADER_OBJECT): $(EXECUTABLE_LOADER_SOURCE) $(EXECUTABLE_LOADER_HEADER) $(EXECUTABLE_FORMAT_HEADER) $(PROGRAM_SERVICES_HEADER) $(FILESYSTEM_HEADER) $(MEMORY_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(EXECUTABLE_LOADER_SOURCE) -o $(EXECUTABLE_LOADER_OBJECT)

$(EXECUTABLE_CALL_OBJECT): $(EXECUTABLE_CALL_SOURCE)
	$(ASSEMBLER) $(ASSEMBLER_FLAGS_ELF) $(EXECUTABLE_CALL_SOURCE) -o $(EXECUTABLE_CALL_OBJECT)

# Build Kernel
$(KERNEL_MAIN_OBJECT): $(KERNEL_MAIN_SOURCE) $(TYPES_HEADER) $(MEMORY_HEADER) $(VGA_HEADER) $(WELCOME_SCREEN_HEADER) $(KEYBOARD_DRIVER_OBJECT) $(ATA_DRIVER_OBJECT) $(FILESYSTEM_STORAGE_OBJECT) $(FILESYSTEM_OBJECT) $(EXECUTABLE_LOADER_HEADER) $(EXECUTABLE_FORMAT_HEADER) $(PROGRAM_SERVICES_HEADER)
	$(C_COMPILER) $(C_COMPILER_FLAGS) -c $(KERNEL_MAIN_SOURCE) -o $(KERNEL_MAIN_OBJECT)
# Link Second Stage
$(SECOND_STAGE_LINKED): $(LINKER_SOURCE) $(START_PROTECTED_OBJECT) $(KERNEL_MAIN_OBJECT) $(IDT_OBJECT) $(ISR_OBJECT) $(VGA_OBJECT) $(KEYBOARD_DRIVER_OBJECT) $(ATA_DRIVER_OBJECT) $(BLOCK_DEVICE_OBJECT) $(FILESYSTEM_STORAGE_OBJECT) $(FILESYSTEM_OBJECT) $(MEMORY_OBJECT) $(EXECUTABLE_LOADER_OBJECT) $(EXECUTABLE_CALL_OBJECT)
	$(LINKER) $(LINKER_FLAGS) -T $(LINKER_SOURCE) -o $(SECOND_STAGE_LINKED) $(START_PROTECTED_OBJECT) $(KERNEL_MAIN_OBJECT) $(IDT_OBJECT) $(ISR_OBJECT) $(VGA_OBJECT) $(KEYBOARD_DRIVER_OBJECT) $(ATA_DRIVER_OBJECT) $(BLOCK_DEVICE_OBJECT) $(FILESYSTEM_STORAGE_OBJECT) $(FILESYSTEM_OBJECT) $(MEMORY_OBJECT) $(EXECUTABLE_LOADER_OBJECT) $(EXECUTABLE_CALL_OBJECT)

# Convert Second Stage to Binary
$(SECOND_STAGE_BINARY): $(SECOND_STAGE_LINKED)
	$(OBJ_COPY) $(OBJ_COPY_FLAGS) $(SECOND_STAGE_LINKED) $(SECOND_STAGE_BINARY)
	truncate -s %512 $(SECOND_STAGE_BINARY)

# Run Emulator
run: all
	$(EMULATOR) -drive format=raw,file=$(TARGET) $(EMULATOR_FLAGS)

_run:
	@if [ ! -f "$(TARGET)" ]; then \
		echo "Error: $(TARGET) does not exist."; \
		exit 1; \
	else \
		echo "$(EMULATOR) -drive format=raw,file=$(TARGET)"; \
		$(EMULATOR) -drive format=raw,file=$(TARGET); \
	fi

debug: all
	$(EMULATOR) -drive format=raw,file=$(TARGET) $(EMULATOR_FLAGS) $(EMULATOR_DEBUG_FLAGS)

gdb:
	gdb $(SECOND_STAGE_LINKED) -ex "target remote localhost:1234"

# Clean Targets
clean:
	rm -rf $(BUILD_DIR)

_clean:
	rm -rf $(INTERMEDIATE_DIR)
